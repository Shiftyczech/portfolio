    <meta name="twitter:title" content="Zeroczech | Cybersecurity & Penetration Testing Portfolio">
    <meta name="twitter:description" content="Portfolio of Zeroczech - Cybersecurity Enthusiast, CTF Player, and Aspiring Penetration Tester.">
    <meta name="twitter:image" content="https://avatars.githubusercontent.com/u/85688123?v=4">

    <!-- Favicon (SVG Terminal Hacker Icon) -->
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='%2310b981'><path d='M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm-8 12.5H6.5c-.28 0-.5-.22-.5-.5s.22-.5.5-.5H12c.28 0 .5.22.5.5s-.22.5-.5.5zm-4.79-3.71l-2.5-2.5c-.39-.39-.39-1.02 0-1.41l2.5-2.5c.39-.39 1.02-.39 1.41 0 .39.39.39 1.02 0 1.41L5.33 10.5l2.79 2.79c.39.39.39 1.02 0 1.41-.39.39-1.02.39-1.41 0z'/></svg>">

    <!-- Tailwind CSS (via CDN) -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        dark: {
                            950: '#06090e',
                            900: '#090d16',
                            850: '#0d131f',
                            800: '#111a2b',
                            700: '#1b273d',
                        },
                        accent: {
                            emerald: '#10b981',
                            cyan: '#06b6d4',
                            glow: 'rgba(16, 185, 129, 0.15)',
                        }
                    },
                    fontFamily: {
                        mono: ['JetBrains Mono', 'Fira Code', 'Courier New', 'monospace'],
                        sans: ['Inter', 'system-ui', '-apple-system', 'sans-serif'],
                    },
                    animation: {
                        'pulse-slow': 'pulse 3s cubic-bezier(0.4, 0, 0.6, 1) infinite',
                        'float': 'float 5s ease-in-out infinite',
                    },
                    keyframes: {
                        float: {
                            '0%, 100%': { transform: 'translateY(0px)' },
                            '50%': { transform: 'translateY(-6px)' },
                        }
                    }
                }
            }
        }
    </script>

    <!-- FontAwesome 6 (via CDN) -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA==" crossorigin="anonymous" referrerpolicy="no-referrer" />

    <!-- Google Fonts: Inter & JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">

    <style>
        /* Custom subtle cyber background pattern */
        body {
            background-color: #080c14;
            background-image: 
                radial-gradient(circle at 15% 15%, rgba(16, 185, 129, 0.05) 0%, transparent 40%),
                radial-gradient(circle at 85% 65%, rgba(6, 182, 212, 0.04) 0%, transparent 45%),
                linear-gradient(to right, rgba(255, 255, 255, 0.015) 1px, transparent 1px),
                linear-gradient(to bottom, rgba(255, 255, 255, 0.015) 1px, transparent 1px);
            background-size: 100% 100%, 100% 100%, 48px 48px, 48px 48px;
            font-family: 'Inter', sans-serif;
            color: #cbd5e1;
        }

        /* Custom Scrollbar */
        ::-webkit-scrollbar {
            width: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #090d16;
        }
        ::-webkit-scrollbar-thumb {
            background: #1e293b;
            border-radius: 4px;
            border: 1px solid #334155;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #10b981;
        }

        /* Glassmorphism & Cyber Card Effects */
        .cyber-card {
            background: rgba(13, 19, 31, 0.75);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.07);
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }
        .cyber-card:hover {
            border-color: rgba(16, 185, 129, 0.4);
            box-shadow: 0 10px 25px -5px rgba(16, 185, 129, 0.12), 0 0 15px 0 rgba(16, 185, 129, 0.06);
            transform: translateY(-3px);
        }

        /* Terminal Prompt Cursor */
        .terminal-cursor {
            display: inline-block;
            width: 8px;
            height: 16px;
            background-color: #10b981;
            vertical-align: middle;
            animation: blink 1.1s infinite;
        }
        @keyframes blink {
            0%, 49% { opacity: 1; }
            50%, 100% { opacity: 0; }
        }

        /* Notification Toast */
        #toast {
            visibility: hidden;
            opacity: 0;
            transition: opacity 0.3s, visibility 0.3s, transform 0.3s;
            transform: translateY(20px);
        }
        #toast.show {
            visibility: visible;
            opacity: 1;
            transform: translateY(0);
        }
    </style>
</head>
<body class="selection:bg-emerald-500 selection:text-black min-h-screen flex flex-col justify-between overflow-x-hidden">

    <!-- Toast Notification for Actions (e.g. Copying PGP/Email) -->
    <div id="toast" class="fixed bottom-6 right-6 z-50 flex items-center gap-3 bg-dark-850 border border-emerald-500/50 text-emerald-400 px-4 py-3 rounded-lg shadow-2xl backdrop-blur-md">
        <i class="fa-solid fa-circle-check text-emerald-400"></i>
        <span id="toast-message" class="text-sm font-mono font-medium">Copied to clipboard!</span>
    </div>

    <!-- 1. NAVBAR -->
    <header class="sticky top-0 z-40 w-full backdrop-blur-md bg-dark-950/85 border-b border-gray-800/80 transition-all duration-300">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex items-center justify-between h-16 sm:h-20">
                
                <!-- Logo / Terminal Prompt -->
                <a href="#hero" class="flex items-center gap-2 group text-slate-100 font-mono text-base sm:text-lg font-semibold tracking-wide">
                    <span class="text-emerald-400 group-hover:text-cyan-400 transition-colors">&gt;</span>
                    <span class="group-hover:text-emerald-400 transition-colors">zeroczech</span>
                    <span class="terminal-cursor"></span>
                </a>

                <!-- Desktop Navigation Links -->
                <nav class="hidden md:flex items-center gap-7 text-sm font-medium text-slate-300">
                    <a href="#about" class="hover:text-emerald-400 transition-colors" data-en="About" data-cs="O mně">About</a>
                    <a href="#skills" class="hover:text-emerald-400 transition-colors" data-en="Skills" data-cs="Dovednosti">Skills</a>
                    <a href="#platforms" class="hover:text-emerald-400 transition-colors" data-en="Platforms" data-cs="Platformy">Platforms</a>
                    <a href="#projects" class="hover:text-emerald-400 transition-colors" data-en="Projects" data-cs="Projekty">Projects</a>
                    <a href="#certs" class="hover:text-emerald-400 transition-colors" data-en="Certs" data-cs="Certifikace">Certs</a>
                    <a href="#contact" class="hover:text-emerald-400 transition-colors" data-en="Contact" data-cs="Kontakt">Contact</a>
                </nav>

                <!-- Right Actions: Language Switcher & Mobile Menu Trigger -->
                <div class="flex items-center gap-3">
                    
                    <!-- Language Switcher Pill Button -->
                    <div class="flex items-center bg-dark-850 border border-gray-700/80 rounded-full p-1 shadow-inner" role="group" aria-label="Language selection">
                        <button id="lang-en" onclick="setLanguage('en')" class="px-2.5 py-1 text-xs font-mono font-bold rounded-full transition-all duration-200 bg-emerald-500/20 text-emerald-400 border border-emerald-500/40">
                            EN
                        </button>
                        <button id="lang-cs" onclick="setLanguage('cs')" class="px-2.5 py-1 text-xs font-mono font-bold rounded-full transition-all duration-200 text-slate-400 hover:text-slate-200">
                            CZ
                        </button>
                    </div>

                    <!-- Connect CTA Button (Desktop) -->
                    <a href="#contact" class="hidden sm:inline-flex items-center gap-2 px-3.5 py-1.5 text-xs font-mono font-semibold rounded-lg bg-emerald-500/10 text-emerald-400 border border-emerald-500/30 hover:bg-emerald-500 hover:text-dark-950 transition-all duration-200">
                        <i class="fa-solid fa-terminal text-xs"></i>
                        <span data-en="Initialize Comms" data-cs="Zahájit spojení">Initialize Comms</span>
                    </a>

                    <!-- Mobile Menu Hamburger Button -->
                    <button id="mobile-menu-btn" class="md:hidden p-2 text-slate-400 hover:text-emerald-400 focus:outline-none" aria-label="Toggle navigation menu">
                        <i class="fa-solid fa-bars text-xl" id="menu-icon"></i>
                    </button>
                </div>
            </div>
        </div>

        <!-- Mobile Drawer Menu -->
        <div id="mobile-menu" class="hidden md:hidden border-b border-gray-800 bg-dark-900/95 px-4 pt-3 pb-6 space-y-3">
            <a href="#about" class="mobile-link block text-sm font-medium py-2 px-3 rounded hover:bg-dark-800 text-slate-300 hover:text-emerald-400" data-en="About" data-cs="O mně">About</a>
            <a href="#skills" class="mobile-link block text-sm font-medium py-2 px-3 rounded hover:bg-dark-800 text-slate-300 hover:text-emerald-400" data-en="Skills" data-cs="Dovednosti">Skills</a>
            <a href="#platforms" class="mobile-link block text-sm font-medium py-2 px-3 rounded hover:bg-dark-800 text-slate-300 hover:text-emerald-400" data-en="Platforms" data-cs="Platformy">Platforms</a>
            <a href="#projects" class="mobile-link block text-sm font-medium py-2 px-3 rounded hover:bg-dark-800 text-slate-300 hover:text-emerald-400" data-en="Projects" data-cs="Projekty">Projects</a>
            <a href="#certs" class="mobile-link block text-sm font-medium py-2 px-3 rounded hover:bg-dark-800 text-slate-300 hover:text-emerald-400" data-en="Certs" data-cs="Certifikace">Certs</a>
            <a href="#contact" class="mobile-link block text-sm font-medium py-2 px-3 rounded hover:bg-dark-800 text-slate-300 hover:text-emerald-400" data-en="Contact" data-cs="Kontakt">Contact</a>
        </div>
    </header>

    <!-- MAIN CONTENT -->
    <main class="flex-grow">
        
        <!-- 2. HERO SECTION -->
        <section id="hero" class="relative pt-16 pb-20 md:pt-28 md:pb-32 overflow-hidden">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
                    
                    <!-- Left Hero Content -->
                    <div class="lg:col-span-7 space-y-6 text-center lg:text-left">
                        
                        <!-- Status Badge -->
                        <div class="inline-flex items-center gap-2.5 px-3 py-1.5 rounded-full bg-emerald-500/10 border border-emerald-500/25 text-emerald-400 text-xs font-mono">
                            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
                            <span data-en="STATUS: AVAILABLE FOR SECURITY ROLES & CTF" data-cs="STAV: K DISPOZICI PRO BEZPEČNOSTNÍ ROLE A CTF">STATUS: AVAILABLE FOR SECURITY ROLES & CTF</span>
                        </div>

                        <!-- Headline -->
                        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-slate-100 tracking-tight leading-tight">
                            <span data-en="Hi, I'm" data-cs="Ahoj, já jsem">Hi, I'm</span>
                            <span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 via-teal-300 to-cyan-400">Zeroczech</span>
                        </h1>

                        <!-- Subheadline -->
                        <p class="text-lg sm:text-xl font-mono text-emerald-400/90 font-medium" data-en="Cybersecurity Enthusiast | CTF Player | Aspiring Penetration Tester" data-cs="Nadšenec do kybernetické bezpečnosti | CTF hráč | Aspirující penetrační tester">
                            Cybersecurity Enthusiast | CTF Player | Aspiring Penetration Tester
                        </p>

                        <!-- Bio / Description -->
                        <p class="text-slate-300 text-base sm:text-lg max-w-2xl mx-auto lg:mx-0 leading-relaxed font-light" data-en="Dedicated to understanding how systems break to engineer unbreakable defenses. Focusing on offensive security methodologies, web exploitation, network enumeration, and privilege escalation." data-cs="Věnuji se zkoumání zranitelností systémů s cílem vytvářet neprolomitelnou obranu. Zaměřuji se na metodiky ofenzivní bezpečnosti, webové zranitelnosti, skenování sítí a eskalaci oprávnění.">
                            Dedicated to understanding how systems break to engineer unbreakable defenses. Focusing on offensive security methodologies, web exploitation, network enumeration, and privilege escalation.
                        </p>

                        <!-- Action Buttons -->
                        <div class="flex flex-wrap items-center justify-center lg:justify-start gap-4 pt-2">
                            <a href="#projects" class="inline-flex items-center gap-2.5 px-6 py-3 rounded-lg font-medium text-sm text-dark-950 bg-emerald-400 hover:bg-emerald-300 transition-all shadow-[0_0_20px_rgba(16,185,129,0.3)] hover:shadow-[0_0_25px_rgba(16,185,129,0.5)] font-mono font-semibold">
                                <i class="fa-solid fa-crosshairs"></i>
                                <span data-en="View Work" data-cs="Zobrazit projekty">View Work</span>
                            </a>

                            <a href="#cv" onclick="handleCvDownload(event)" class="inline-flex items-center gap-2.5 px-6 py-3 rounded-lg font-medium text-sm text-slate-200 bg-dark-850 hover:bg-dark-800 border border-gray-700 hover:border-emerald-500/50 transition-all font-mono">
                                <i class="fa-solid fa-file-arrow-down text-emerald-400"></i>
                                <span data-en="Download CV" data-cs="Stáhnout CV">Download CV</span>
                            </a>
                        </div>

                        <!-- Social Icons -->
                        <div class="pt-4 flex flex-wrap items-center justify-center lg:justify-start gap-3 sm:gap-4 text-slate-400">
                            <span class="text-xs font-mono text-slate-500 uppercase tracking-wider" data-en="Links:" data-cs="Odkazy:">Links:</span>
                            
                            <a href="https://github.com/Shiftyczech" target="_blank" rel="noopener noreferrer" class="p-2.5 rounded-lg bg-dark-850 border border-gray-800 hover:text-emerald-400 hover:border-emerald-500/50 transition-all" title="GitHub Profile" aria-label="GitHub Profile">
                                <i class="fa-brands fa-github text-lg"></i>
                            </a>
                            <a href="https://www.linkedin.com/in/%C5%A1imon-tobi%C3%A1%C5%A1-7a60933ab/" target="_blank" rel="noopener noreferrer" class="p-2.5 rounded-lg bg-dark-850 border border-gray-800 hover:text-cyan-400 hover:border-cyan-500/50 transition-all" title="LinkedIn Profile" aria-label="LinkedIn Profile">
                                <i class="fa-brands fa-linkedin text-lg"></i>
                            </a>
                            <a href="https://x.com/simontobis75011" target="_blank" rel="noopener noreferrer" class="p-2.5 rounded-lg bg-dark-850 border border-gray-800 hover:text-slate-100 hover:border-slate-500/50 transition-all" title="X (Twitter) Profile" aria-label="X Profile">
                                <i class="fa-brands fa-x-twitter text-lg"></i>
                            </a>
                            <a href="https://www.instagram.com/simon_tobias_/" target="_blank" rel="noopener noreferrer" class="p-2.5 rounded-lg bg-dark-850 border border-gray-800 hover:text-pink-400 hover:border-pink-500/50 transition-all" title="Instagram Profile" aria-label="Instagram Profile">
                                <i class="fa-brands fa-instagram text-lg"></i>
                            </a>
                            <a href="mailto:anomyous601@proton.me" class="p-2.5 rounded-lg bg-dark-850 border border-gray-800 hover:text-emerald-400 hover:border-emerald-500/50 transition-all" title="Encrypted Email" aria-label="Email">
                                <i class="fa-solid fa-envelope text-lg"></i>
                            </a>
                            <a href="https://tryhackme.com/p/Zeroczech" target="_blank" rel="noopener noreferrer" class="p-2.5 rounded-lg bg-dark-850 border border-gray-800 hover:text-red-400 hover:border-red-500/50 transition-all" title="TryHackMe @Zeroczech" aria-label="TryHackMe">
                                <i class="fa-solid fa-fire-flame-curved text-lg"></i>
                            </a>
                        </div>
                    </div>

                    <!-- Right Hero Interactive Terminal Mockup -->
                    <div class="lg:col-span-5">
                        <div class="cyber-card rounded-xl border border-gray-800 shadow-2xl overflow-hidden font-mono text-xs sm:text-sm">
                            
                            <!-- Terminal Header -->
                            <div class="bg-dark-950 px-4 py-3 border-b border-gray-800 flex items-center justify-between">
                                <div class="flex items-center gap-2">
                                    <span class="w-3 h-3 rounded-full bg-red-500/80 inline-block"></span>
                                    <span class="w-3 h-3 rounded-full bg-yellow-500/80 inline-block"></span>
                                    <span class="w-3 h-3 rounded-full bg-green-500/80 inline-block"></span>
                                </div>
                                <div class="text-slate-400 text-xs flex items-center gap-1.5">
                                    <i class="fa-solid fa-lock text-[10px] text-emerald-400"></i>
                                    <span>zero@sec-lab: ~</span>
                                </div>
                                <div class="text-slate-600 text-xs">bash</div>
                            </div>

                            <!-- Terminal Body -->
                            <div class="p-5 space-y-3.5 bg-dark-900/90 text-slate-300">
                                <div>
                                    <span class="text-emerald-400">zero@sec-lab</span>:<span class="text-cyan-400">~</span>$ whoami
                                    <p class="text-slate-200 mt-1 pl-2 border-l border-emerald-500/40" data-en="&gt; Zeroczech | Ethical Hacker &amp; Security Researcher" data-cs="&gt; Zeroczech | Etický hacker &amp; bezpečnostní výzkumník">&gt; Zeroczech | Ethical Hacker &amp; Security Researcher</p>
                                </div>

                                <div>
                                    <span class="text-emerald-400">zero@sec-lab</span>:<span class="text-cyan-400">~</span>$ cat core_focus.json
                                    <div class="text-slate-300 mt-1 pl-2 border-l border-cyan-500/40 text-[11px] sm:text-xs">
                                        <pre class="text-slate-400">{
  <span class="text-emerald-400">"specialization"</span>: <span class="text-cyan-300">"Offensive Security & Pentesting"</span>,
  <span class="text-emerald-400">"interests"</span>: [<span class="text-amber-300">"Web Exploitation"</span>, <span class="text-amber-300">"Active Directory"</span>, <span class="text-amber-300">"Network Recon"</span>],
  <span class="text-emerald-400">"primary_os"</span>: <span class="text-cyan-300">"Kali Linux / Arch Linux"</span>,
  <span class="text-emerald-400">"status"</span>: <span class="text-emerald-300">"Always learning. Always pwning."</span>
}</pre>
                                    </div>
                                </div>

                                <div>
                                    <span class="text-emerald-400">zero@sec-lab</span>:<span class="text-cyan-400">~</span>$ ./check_defense.sh
                                    <p class="text-emerald-400 mt-1 font-semibold pl-2 border-l border-emerald-500/40 flex items-center gap-1.5">
                                        <i class="fa-solid fa-shield-halved text-xs"></i>
                                        <span data-en="[+] Systems audited: Hardened mindset engaged" data-cs="[+] Systémy prověřeny: Nastaveno bezpečnostní myšlení">[+] Systems audited: Hardened mindset engaged</span>
                                    </p>
                                </div>

                                <div class="pt-1 flex items-center text-slate-500">
                                    <span class="text-emerald-400">zero@sec-lab</span>:<span class="text-cyan-400">~</span>$&nbsp;
                                    <span class="terminal-cursor"></span>
                                </div>
                            </div>

                        </div>
                    </div>

                </div>
            </div>
        </section>

        <!-- ABOUT SECTION -->
        <section id="about" class="py-16 md:py-24 border-t border-gray-800/60 relative">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                
                <div class="text-center max-w-3xl mx-auto mb-16">
                    <h2 class="text-xs font-mono font-semibold tracking-widest text-emerald-400 uppercase mb-2" data-en="// 01. INTRO" data-cs="// 01. PŘEDSTAVENÍ">// 01. INTRO</h2>
                    <h3 class="text-3xl sm:text-4xl font-bold text-slate-100" data-en="About & Mindset" data-cs="O mně a můj přístup">About & Mindset</h3>
                    <div class="w-16 h-1 bg-gradient-to-r from-emerald-500 to-cyan-500 mx-auto mt-4 rounded-full"></div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                    
                    <!-- Card 1: Offensive Security -->
                    <div class="cyber-card p-6 rounded-xl space-y-4">
                        <div class="w-12 h-12 rounded-lg bg-emerald-500/10 border border-emerald-500/30 flex items-center justify-center text-emerald-400 text-xl">
                            <i class="fa-solid fa-bug"></i>
                        </div>
                        <h4 class="text-xl font-bold text-slate-100" data-en="Offensive Security" data-cs="Ofenzivní bezpečnost">Offensive Security</h4>
                        <p class="text-slate-300 text-sm leading-relaxed" data-en="Adopting the attacker's perspective to discover logic flaws, misconfigurations, and vulnerabilities before malicious actors can exploit them." data-cs="Přijímám úhel pohledu útočníka k odhalení logických chyb, špatných konfigurací a zranitelností dříve, než je zneužijí záškodníci.">
                            Adopting the attacker's perspective to discover logic flaws, misconfigurations, and vulnerabilities before malicious actors can exploit them.
                        </p>
                    </div>

                    <!-- Card 2: CTF & Problem Solving -->
                    <div class="cyber-card p-6 rounded-xl space-y-4">
                        <div class="w-12 h-12 rounded-lg bg-cyan-500/10 border border-cyan-500/30 flex items-center justify-center text-cyan-400 text-xl">
