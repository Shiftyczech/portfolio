<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">

    <!-- Primary Meta Tags -->
    <title>Zeroczech | Cybersecurity & Penetration Testing Portfolio</title>
    <meta name="title" content="Zeroczech | Cybersecurity & Penetration Testing Portfolio">
    <meta name="description" content="Portfolio of Zeroczech - Cybersecurity Enthusiast, CTF Player, and Aspiring Penetration Tester specializing in offensive security, network analysis, and vulnerability assessment.">
    <meta name="keywords" content="cybersecurity, penetration testing, ethical hacking, CTF, TryHackMe, HackTheBox, Zeroczech, Kali Linux, security researcher">
    <meta name="author" content="Zeroczech">
    <meta name="theme-color" content="#090d16">

    <!-- Open Graph / Facebook / Discord / LinkedIn -->
    <meta property="og:type" content="website">
    <meta property="og:url" content="https://shiftyczech.github.io/">
    <meta property="og:title" content="Zeroczech | Cybersecurity & Penetration Testing Portfolio">
    <meta property="og:description" content="Portfolio of Zeroczech - Cybersecurity Enthusiast, CTF Player, and Aspiring Penetration Tester. Discover projects, CTF write-ups, tools, and certifications.">
    
    <meta property="og:site_name" content="Zeroczech Portfolio">

    <!-- Open Graph Image -->
    <meta property="og:image" content="https://avatars.githubusercontent.com/u/85688123?v=4">

    <!-- Twitter Meta Tags -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:site" content="@simontobis75011">
    <meta name="twitter:creator" content="@simontobis75011">
