                                <span class="text-xs font-mono px-2.5 py-1 rounded bg-dark-950 text-slate-300 border border-gray-800"><i class="fa-brands fa-docker text-blue-400 mr-1.5"></i>Docker Compose</span>
                                <span class="text-xs font-mono px-2.5 py-1 rounded bg-dark-950 text-slate-300 border border-gray-800"><i class="fa-brands fa-android text-emerald-500 mr-1.5"></i>Android APK</span>
                            </div>

