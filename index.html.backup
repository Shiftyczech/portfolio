                    <!-- Flagship Project: TorE2EE Messenger -->
                    <div class="cyber-card rounded-2xl overflow-hidden border border-emerald-500/30 bg-dark-900/90 shadow-2xl shadow-emerald-500/5 group hover:border-emerald-500/60 transition-all duration-300">
                        <div class="p-6 sm:p-8 lg:p-10 space-y-6">
                            
                            <!-- Header meta badges -->
                            <div class="flex flex-wrap items-center justify-between gap-4">
                                <div class="flex flex-wrap items-center gap-2">
                                    <span class="px-3 py-1 rounded text-xs font-mono bg-emerald-500/10 text-emerald-400 border border-emerald-500/30 flex items-center gap-1.5">
                                        <i class="fa-solid fa-lock text-[11px]"></i>
                                        <span>FLAGSHIP SECURITY PROJECT</span>
                                    </span>
                                    <span class="px-2.5 py-1 rounded text-xs font-mono bg-cyan-500/10 text-cyan-400 border border-cyan-500/30 flex items-center gap-1.5">
