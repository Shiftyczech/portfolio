    <!-- JAVASCRIPT: Language Switcher, Toast Notification & Mobile Menu -->
    <script>
        // Set dynamic current year in footer
        document.getElementById('current-year').textContent = new Date().getFullYear();

        // 1. LANGUAGE SWITCHER (EN / CZ)
        let currentLang = localStorage.getItem('portfolio_lang') || 'en';

        function setLanguage(lang) {
            currentLang = lang;
            localStorage.setItem('portfolio_lang', lang);
            document.documentElement.lang = lang;

            // Update Language Switcher UI styles
            const btnEn = document.getElementById('lang-en');
            const btnCs = document.getElementById('lang-cs');

            if (lang === 'en') {
                btnEn.className = "px-2.5 py-1 text-xs font-mono font-bold rounded-full transition-all duration-200 bg-emerald-500/20 text-emerald-400 border border-emerald-500/40";
                btnCs.className = "px-2.5 py-1 text-xs font-mono font-bold rounded-full transition-all duration-200 text-slate-400 hover:text-slate-200";
            } else {
                btnCs.className = "px-2.5 py-1 text-xs font-mono font-bold rounded-full transition-all duration-200 bg-emerald-500/20 text-emerald-400 border border-emerald-500/40";
                btnEn.className = "px-2.5 py-1 text-xs font-mono font-bold rounded-full transition-all duration-200 text-slate-400 hover:text-slate-200";
            }

            // Update text elements with data-en and data-cs
            const elements = document.querySelectorAll('[data-en][data-cs]');
            elements.forEach(el => {
                const translation = el.getAttribute(`data-${lang}`);
                if (translation) {
                    el.innerHTML = translation;
                }
            });

            // Update input placeholders
            const inputs = document.querySelectorAll('[data-en-placeholder][data-cs-placeholder]');
            inputs.forEach(input => {
                const placeholder = input.getAttribute(`data-${lang}-placeholder`);
                if (placeholder) {
                    input.placeholder = placeholder;
                }
            });
        }

        // Initialize language on DOM ready
        document.addEventListener('DOMContentLoaded', () => {
            setLanguage(currentLang);
        });

        // 2. MOBILE MENU TOGGLE
        const mobileMenuBtn = document.getElementById('mobile-menu-btn');
        const mobileMenu = document.getElementById('mobile-menu');
        const menuIcon = document.getElementById('menu-icon');

        if (mobileMenuBtn && mobileMenu) {
            mobileMenuBtn.addEventListener('click', () => {
                const isOpen = !mobileMenu.classList.contains('hidden');
                if (isOpen) {
                    mobileMenu.classList.add('hidden');
                    menuIcon.classList.remove('fa-xmark');
                    menuIcon.classList.add('fa-bars');
                } else {
                    mobileMenu.classList.remove('hidden');
                    menuIcon.classList.remove('fa-bars');
                    menuIcon.classList.add('fa-xmark');
                }
            });

            // Close mobile menu on clicking any navigation link
            document.querySelectorAll('.mobile-link').forEach(link => {
                link.addEventListener('click', () => {
                    mobileMenu.classList.add('hidden');
                    menuIcon.classList.remove('fa-xmark');
                    menuIcon.classList.add('fa-bars');
                });
            });
        }

        // 3. TOAST NOTIFICATION UTILITY (e.g. for copying PGP / Email)
        let toastTimeout;
        function showToast(message) {
            const toast = document.getElementById('toast');
            const toastMessage = document.getElementById('toast-message');
            toastMessage.textContent = message;
            toast.classList.add('show');
            clearTimeout(toastTimeout);
            toastTimeout = setTimeout(() => {
                toast.classList.remove('show');
            }, 3000);
        }

        function copyToClipboard(text, successMsg) {
            navigator.clipboard.writeText(text).then(() => {
                showToast(successMsg || 'Copied to clipboard!');
            }).catch(() => {
                showToast('Copied: ' + text);
            });
        }

        // 4. CV DOWNLOAD HANDLER (Placeholder with clear feedback)
        function handleCvDownload(e) {
            e.preventDefault();
            const msg = currentLang === 'cs' ? 'Životopis bude brzy k dispozici ke stažení!' : 'CV PDF will be available for download shortly!';
            showToast(msg);
        }
    </script>
</body>
</html>
