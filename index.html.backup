                                                class="w-full bg-dark-900 border border-gray-800 focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 rounded-lg px-3.5 py-2.5 text-sm text-slate-100 placeholder-slate-600 outline-none transition-all"
                                                placeholder="name@domain.com"
                                                data-en-placeholder="name@domain.com"
